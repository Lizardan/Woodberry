{
  "$schema": "https://opencode.ai/config.json",

  "instructions": [
    "AGENTS.md",
    "instructions/*.md",
    "docs/specs/*.md"
  ],

  "permission": {
    "skill": {
      "*": "deny",
      "unity-architecture-review": "allow",
      "unity-test-strategy": "allow",
      "unity-prefab-safety": "allow",
      "coop-networking-model": "allow",
      "horror-level-design": "allow",
      "urp-visual-tuning": "allow",
      "stage-planning": "allow",
      "stage-report": "allow",
      "debug-unity-console": "allow"
    },
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git add*": "ask",
      "git commit*": "ask",
      "git push*": "deny",
      "git reset --hard*": "deny",
      "git checkout .*": "deny",
      "git clean*": "deny",
      "rm -rf*": "deny",
      "Remove-Item -Recurse*": "deny",
      "git checkout*": "deny"
    },
    "edit": "allow",
    "webfetch": "allow"
  },

  "mcp": {
    "unityMCP": {
      "type": "local",
      "command": [
        "C:\\Users\\Lizardan\\.local\\bin\\uvx.exe",
        "--from",
        "mcpforunityserver==10.1.2",
        "mcp-for-unity",
        "--transport",
        "stdio"
      ],
      "enabled": true
    }
  },

  "agent": {
    "build": {
      "permission": {
        "task": {
          "*": "deny",
          "system-analyst": "allow",
          "gameplay-engineer": "allow",
          "scene-level-designer": "allow",
          "ui-engineer": "allow",
          "technical-artist": "allow",
          "unity-tools-engineer": "allow",
          "qa-analyst": "allow",
          "explore": "allow",
          "general": "allow"
        },
        "bash": {
          "*": "allow",
          "git push*": "deny",
          "git commit*": "ask",
          "git reset --hard*": "deny",
          "git clean*": "deny",
          "rm -rf*": "deny",
          "Remove-Item -Recurse*": "deny"
        }
      }
    },

    "plan": {
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "ask",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow"
        }
      }
    },

    "gameplay-engineer": {
      "permission": {
        "edit": "allow"
      }
    },

    "qa-analyst": {
      "permission": {
        "edit": "allow"
      }
    },

    "system-analyst": {
      "permission": {
        "edit": "allow"
      }
    },

    "unity-tools-engineer": {
      "permission": {
        "edit": "allow"
      }
    },

    "scene-level-designer": {
